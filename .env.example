PORT=8000
DATABASE_URL=postgres://free2talk:free2talk_dev@localhost:5432/free2talk?sslmode=disable
JWT_SECRET=change_this_to_a_random_secret_minimum_32_chars
LIBRETRANSLATE_URL=http://localhost:5000

# ML service — Unix socket (default, recommended) or TCP fallback
# ML_SOCKET_PATH=/tmp/free2talk-ml.sock   # leave commented to use default
# ML_SERVICE_URL=http://localhost:8090    # only used if ML_SOCKET_PATH is unset

# Set to true only for local development — loosens CORS and WS origin checks
DEV_MODE=false

# Registration key — if set, users must supply this key to create an account.
# Leave empty to allow open registration.
REGISTRATION_KEY=

# VAD thresholds — tune for your mic environment (all optional, defaults shown)
# VAD_SPEECH_RMS_MIN=0.015    # RMS energy floor; raise for noisy envs (e.g. 0.03), lower for quiet headsets (e.g. 0.008)
# VAD_SILENCE_FRAMES=12       # silent 50ms chunks before flushing utterance (~600ms); lower = faster caption, more splits
# VAD_MIN_SPEECH_FRAMES=3     # minimum speech frames to discard noise bursts (~150ms)
# VAD_MAX_SPEECH_FRAMES=200   # hard cap on utterance length (~10s)
